{
  "name": "onboarding-flow",
  "version": "1.0.0",
  "private": true,
  "description": "Multi-step onboarding: Next.js, NestJS and PostgreSQL, with server-side validation, resumable progress and a funnel report.",
  "license": "MIT",
  "engines": { "node": ">=20" },
  "workspaces": ["apps/*"],
  "scripts": {
    "dev": "concurrently -n api,web -c blue,green \"npm:dev:api\" \"npm:dev:web\"",
    "dev:api": "npm run start:dev -w @onboarding-flow/api",
    "dev:web": "npm run dev -w @onboarding-flow/web",
    "build": "npm run build -w @onboarding-flow/api && npm run build -w @onboarding-flow/web",
    "vercel-build": "node scripts/vercel-build.mjs",
    "lint": "eslint .",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "typecheck": "npm run typecheck -w @onboarding-flow/api && npm run typecheck -w @onboarding-flow/web",
    "test": "npm test -w @onboarding-flow/api",
    "test:coverage": "npm test -w @onboarding-flow/api -- --coverage",
    "test:int": "npm run test:int -w @onboarding-flow/api",
    "e2e": "playwright test",
    "screenshots": "playwright test -c playwright.screenshots.config.ts",
    "db:migrate": "npm run db:migrate -w @onboarding-flow/api",
    "db:reset": "npm run db:reset -w @onboarding-flow/api",
    "check": "npm run format:check && npm run lint && npm run typecheck && npm test && npm run build"
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.10.0",
    "@eslint/js": "^9.12.0",
    "@playwright/test": "^1.48.0",
    "@types/node": "^20.14.0",
    "concurrently": "^9.0.0",
    "eslint": "^9.12.0",
    "eslint-plugin-jsx-a11y": "^6.10.0",
    "eslint-plugin-react-hooks": "^5.0.0",
    "prettier": "^3.3.0",
    "typescript": "~5.5.0",
    "typescript-eslint": "^8.8.0"
  }
}
